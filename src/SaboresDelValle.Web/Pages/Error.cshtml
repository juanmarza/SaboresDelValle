@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="sv-card sv-card--formulario mx-auto">
    <div class="sv-card-body">
        <h1 class="sv-page-title">No pudimos completar la operación</h1>
        <p class="sv-page-subtitle mb-4">Ocurrió un error inesperado. Intente nuevamente en unos momentos.</p>

        @if (Model.ShowRequestId)
        {
            <p class="form-text">Código de referencia: <code>@Model.RequestId</code></p>
        }
    </div>
    <div class="sv-card-footer">
        <a asp-page="/Index" class="btn btn-primary">Volver al inicio</a>
    </div>
</div>
