@page
@model SaboresDelValle.Web.Pages.Productos.CrearModel
@{
    ViewData["Title"] = "Nuevo producto";
}

<a asp-page="Index" class="sv-volver"><partial name="_Icono" model='"volver"' /> Volver a productos</a>

<header class="sv-page-header">
    <div>
        <h1 class="sv-page-title">Nuevo producto</h1>
        <p class="sv-page-subtitle">Registre un insumo o materia prima del restaurante.</p>
    </div>
</header>

<form method="post" novalidate class="sv-card sv-card--formulario">
    <div class="sv-card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_CamposProducto" for="Producto" />
    </div>
    <div class="sv-card-footer">
        <button type="submit" class="btn btn-primary">Guardar producto</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
