@page
@model SaboresDelValle.Web.Pages.Productos.EditarModel
@{
    ViewData["Title"] = "Editar producto";
}

<a asp-page="Index" class="sv-volver"><partial name="_Icono" model='"volver"' /> Volver a productos</a>

<header class="sv-page-header">
    <div>
        <h1 class="sv-page-title">Editar producto</h1>
        <p class="sv-page-subtitle">Actualice los datos del insumo y su estado.</p>
    </div>
</header>

@if (Model.NoEncontrado)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>
    <a asp-page="Index" class="btn btn-outline-secondary">Volver a productos</a>
}
else
{
    <form method="post" novalidate class="sv-card sv-card--formulario">
        <div class="sv-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <partial name="_CamposProducto" for="Producto" />

            <fieldset class="sv-grupo">
                <legend class="sv-grupo-titulo">Estado</legend>
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="Activo" class="form-label">Estado del producto</label>
                        <select asp-for="Activo" class="form-select" aria-describedby="ayuda-activo">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                        <div id="ayuda-activo" class="form-text">Un producto inactivo conserva su nombre reservado.</div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="sv-card-footer">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
}
