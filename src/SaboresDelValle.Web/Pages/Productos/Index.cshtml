@page
@using SaboresDelValle.Web.Presentacion
@model SaboresDelValle.Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<header class="sv-page-header">
    <div>
        <h1 class="sv-page-title">Productos</h1>
        <p class="sv-page-subtitle">Administra los insumos utilizados en la preparación de los platos.</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary"><partial name="_Icono" model='"mas"' /> Nuevo producto</a>
</header>

@if (Model.MensajeExito is not null)
{
    <div class="alert alert-success" role="status">@Model.MensajeExito</div>
}

<div class="sv-card">
    @if (Model.Productos.Count == 0)
    {
        <div class="sv-vacio">
            <span class="sv-vacio-icono"><partial name="_Icono" model='"productos"' /></span>
            <h2 class="sv-vacio-titulo">No hay productos registrados.</h2>
            <p class="sv-vacio-texto">Registre el primer insumo para comenzar.</p>
            <a asp-page="Crear" class="btn btn-primary">Nuevo producto</a>
        </div>
    }
    else
    {
        <div class="sv-tabla-contenedor">
            <table class="sv-tabla">
                <caption class="visually-hidden">Listado de productos</caption>
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Unidad de medida</th>
                        <th scope="col" class="sv-num">Stock mínimo</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="sv-acciones"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model.Productos)
                    {
                        <tr>
                            <td class="sv-id">@producto.Id</td>
                            <td class="sv-principal">@producto.Nombre</td>
                            <td>@EtiquetasProducto.Tipo(producto.Tipo)</td>
                            <td>@EtiquetasProducto.Unidad(producto.Unidad)</td>
                            <td class="sv-num">@EtiquetasProducto.StockMinimo(producto.StockMinimo)</td>
                            <td><span class="sv-badge @EtiquetasProducto.ClaseEstado(producto.Activo)">@EtiquetasProducto.Estado(producto.Activo)</span></td>
                            <td class="sv-acciones">
                                <div class="sv-acciones-grupo">
                                    <a asp-page="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary"
                                       aria-label="Editar @producto.Nombre">Editar</a>
                                    <a asp-page="Eliminar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger"
                                       aria-label="Eliminar @producto.Nombre">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
